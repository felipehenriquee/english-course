{
  "name": "english-course",
  "version": "0.0.0",
  "private": true,
  "description": "Monorepo: Angular frontend + NestJS backend",
  "scripts": {
    "prepare": "husky",
    "dev": "concurrently -k -n back,front -c blue,green \"npm:dev:back\" \"npm:dev:front\"",
    "dev:back": "npm --prefix backend run start:dev",
    "dev:front": "npm --prefix frontend run start",
    "db:up": "docker compose -f backend/docker-compose.yml up -d db",
    "db:down": "docker compose -f backend/docker-compose.yml stop db",
    "install:all": "npm install && npm --prefix backend install && npm --prefix frontend install"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "husky": "^9.1.7"
  }
}
