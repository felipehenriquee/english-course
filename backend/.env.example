# ---- App ----
NODE_ENV=development
PORT=3000
# Nome exibido no título do Swagger (ver main.ts)
APP_NAME=SAPO
# Prefixo global das rotas (main.ts) -> API fica em http://localhost:3000/api
# Bate com o VITE_API_BASE_URL / apiBaseUrl usados nas skills de frontend
# (vue-feature-based-frontend, angular-feature-based-frontend, react-feature-based-frontend).
API_PREFIX=api

# Origens autorizadas no CORS (separadas por vírgula). Ajuste para a porta
# do frontend: 5173 (Vite/Vue/React) ou 4200 (Angular).
CORS_ORIGIN=http://localhost:5173,http://localhost:4200

# ---- Banco de dados ----
# DB_TYPE: postgres | mysql | sqlite
# Troque aqui + instale o driver certo (ver SKILL.md, Passo 0) para mudar de banco.
# mysql  -> npm i mysql2   | postgres -> npm i pg   | sqlite -> npm i better-sqlite3
DB_TYPE=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=english_course
DB_PASSWORD=english_course
DB_DATABASE=english_course
# Usado só quando DB_TYPE=sqlite (caminho do arquivo .sqlite):
DB_SQLITE_PATH=./data/backend.sqlite

# Nunca true em produção com dados reais: recria o schema a cada boot.
# Útil em dev antes de configurar migrations de verdade.
DB_SYNCHRONIZE=true

# ---- Auth (JWT) ----
# Gere um valor forte, ex: `openssl rand -base64 48`
JWT_SECRET=troque-este-valor-em-producao
JWT_EXPIRES_IN=1d

# ---- Rate limiting (ver common/ -> ThrottlerModule em app.module.ts) ----
THROTTLE_TTL=60000
THROTTLE_LIMIT=100
